{
  "name": "egressor",
  "displayName": "Egressor",
  "description": "Traffic visibility, egress rule enforcement, secret injection, and audit trails for container-based development",
  "version": "0.0.1",
  "publisher": "egressor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.egressor.yml",
    "onView:egressor.trafficPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "egressor",
          "title": "Egressor",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "egressor": [
        {
          "type": "webview",
          "id": "egressor.trafficPanel",
          "name": "Traffic Panel"
        }
      ]
    },
    "commands": [
      {
        "command": "egressor.start",
        "title": "Egressor: Start"
      },
      {
        "command": "egressor.stop",
        "title": "Egressor: Stop"
      },
      {
        "command": "egressor.showSessionSummary",
        "title": "Egressor: Show Session Summary"
      },
      {
        "command": "egressor.exportSessionLog",
        "title": "Egressor: Export Session Log"
      },
      {
        "command": "egressor.storeSecret",
        "title": "Egressor: Store Secret"
      },
      {
        "command": "egressor.deleteSecret",
        "title": "Egressor: Delete Secret"
      },
      {
        "command": "egressor.listSecrets",
        "title": "Egressor: List Secrets"
      }
    ],
    "configuration": {
      "title": "Egressor",
      "properties": {
        "egressor.httpjailPath": {
          "type": "string",
          "default": "",
          "description": "Path to httpjail binary (auto-detected if empty)"
        },
        "egressor.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Egressor when a .egressor.yml is detected"
        },
        "egressor.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log verbosity level"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "tsc -p ./ && mocha",
    "test:coverage": "tsc -p ./ && nyc mocha"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.0.0",
    "mocha": "^11.3.0",
    "nyc": "^17.1.0",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}